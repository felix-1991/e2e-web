# Copy to .env in your working directory and fill in your DeepSeek API key.
E2E_EXAMPLE_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set all three to run your own task in the DeepSeek, pytest, or unittest example.
# APP_URL=https://demo.playwright.dev/todomvc/
# TASK='Add a todo titled Review invoices and press Enter to save it.'
# EXPECTED='The todo list shows Review invoices.'

# Set both to true to use screenshots with a model/endpoint that accepts images.
E2E_VISION=false
DEEPSEEK_SUPPORTS_VISION=false
