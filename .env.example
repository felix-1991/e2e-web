# Copy to .env in your working directory. Existing environment variables win.
E2E_HEADLESS=true
# Leave unset to use Playwright's Chromium.
# E2E_CHROMIUM_EXECUTABLE=/path/to/chrome
# Enable screenshots in Agent model requests only when intended.
E2E_VISION=false
# Optional observation limits for pages with large semantic trees.
# E2E_OBSERVATION_MAX_NODES=1500
# E2E_OBSERVATION_MAX_BYTES=1048576

# OpenAI-compatible Chat Completions. Use the full /chat/completions URL.
# For the official OpenAI API, use https://api.openai.com/v1/chat/completions.
# Set the model ID and API key for the selected provider.
E2E_MODEL_ENDPOINT=https://your-gateway.example/v1/chat/completions
E2E_MODEL=your-model
E2E_MODEL_API_KEY=
# Select the compatible endpoint in the runnable examples.
# E2E_EXAMPLE_PROVIDER=compatible

# DeepSeekExecutor() reads these defaults:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Enable only if the selected model/endpoint accepts images.
DEEPSEEK_SUPPORTS_VISION=false
